DB_HOST=your_db_host
DB_PORT=3306
DB_USER=your_user
DB_PASSWORD=your_password
DB_NAME=team_5

# 한국환경공단 전기차 충전소 (data.go.kr B552584)
# getChargerInfo / getChargerStatus — scripts/etl/run_status_snapshot.py
EV_SERVICE_KEY=your_ev_service_key

# 기상청 ASOS 시간자료 (data.go.kr AsosHourlyInfoService)
KMA_SERVICE_KEY=your_decoding_service_key

# 소상공인시장진흥공단 상권정보 API (data.go.kr B553077)
# 신청: https://www.data.go.kr/data/15012005/openapi.do
CONTEXT_SERVICE_KEY=your_context_service_key

# 대구광역시 주차장 실시간정보 — 이미 parking_realtime_status 테이블에 수집 중
# 정적 정보는 parking_lot_info 사용 (CSV 재수집 불필요)
# 충전소 매핑: py scripts/etl/run_parking.py --map
PARKING_SERVICE_KEY=

# 대구광역시 교통소통·돌발정보 API (data.go.kr B552061)
